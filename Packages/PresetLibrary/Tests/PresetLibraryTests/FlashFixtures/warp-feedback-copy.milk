MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
// ACC-002 test fixture written for projectM-iOS (MIT). Not a third-party preset.
// QA-011 2026-11-19: the warp shader rewrites the blue channel from red every third frame. The warp
// output is the next frame's input, so the copy settles instead of alternating: not flagged. (The
// same statement in the composite shader is flagged.)
fDecay=0.980000
zoom=1.010000
per_frame_1=wave_r = 0.5 + 0.5*sin(time*0.7);
warp_1=`shader_body
warp_2=`{
warp_3=`    ret = tex2D(sampler_main, uv).xyz;
warp_4=`    float3 prev = ret;
warp_5=`    if (frame%3 == 0) ret.z = .71 - prev.x;
warp_6=`    ret *= 0.98;
warp_7=`}
comp_1=`shader_body
comp_2=`{
comp_3=`    ret = tex2D(sampler_main, uv).xyz * 1.2;
comp_4=`}
