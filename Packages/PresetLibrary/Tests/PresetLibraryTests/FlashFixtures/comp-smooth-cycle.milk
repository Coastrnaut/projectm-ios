MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
// ACC-002 test fixture written for projectM-iOS (MIT). Not a third-party preset.
// QA-011 2026-11-19: slow smooth color cycling in the composite shader: a slow hue sawtooth, a sine
// gain, scrolling stripes (per pixel), a 0.5 Hz fmod and a damped (5 %) 8 Hz pulse. None of it is
// an undamped fast whole-frame switch.
fDecay=0.980000
zoom=1.010000
wave_r=0.6
wave_g=0.6
wave_b=0.9
per_frame_1=wave_r = 0.5 + 0.5*sin(time*0.7);
warp_1=`shader_body
warp_2=`{
warp_3=`    ret = tex2D(sampler_main, uv).xyz * 0.98;
warp_4=`}
comp_1=`shader_body
comp_2=`{
comp_3=`    float hue = frac(time*0.05);                        /* one cycle every 20 s */
comp_4=`    float3 tint = 0.75 + 0.25*cos(6.28*(hue + float3(0, 0.33, 0.67)));
comp_5=`    ret = tex2D(sampler_main, uv).xyz * tint;
comp_6=`    ret *= 0.8 + 0.2*sin(time*0.6);
comp_7=`    ret += 0.2*step(0.5, frac(uv.x*8 + time*4));
comp_8=`    ret *= 1 + 0.5*step(1, fmod(time, 2));
comp_9=`    ret += 0.05*step(0.5, frac(time*8));
comp_10=`}
