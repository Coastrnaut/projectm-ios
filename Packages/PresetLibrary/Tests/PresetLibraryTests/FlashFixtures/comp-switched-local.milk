MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
// ACC-002 test fixture written for projectM-iOS (MIT). Not a third-party preset.
// QA-011 2026-11-19: a 1.5 Hz square wave held in a shader local triples the brightness of the
// whole frame on every other half cycle (the composite shader's only switch).
fDecay=0.980000
zoom=1.010000
per_frame_1=wave_r = 0.5 + 0.5*sin(time*0.7);
comp_1=`shader_body
comp_2=`{
comp_3=`    float t = time * 1.5;
comp_4=`    float pulse = step(0.5, frac(t));
comp_5=`    ret = tex2D(sampler_main, uv).xyz;
comp_6=`    ret *= 1 + 2*pulse;
comp_7=`}
