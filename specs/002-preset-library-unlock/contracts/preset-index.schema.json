{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Coastrnaut/projectm-ios/specs/002-preset-library-unlock/contracts/preset-index.schema.json",
  "title": "PresetIndex",
  "description": "Apps/ProjectMiOS/Resources/PresetIndex.json, written by scripts/build_preset_index.py (feature 002 data-model.md).",
  "type": "object",
  "required": ["version", "presets"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "presets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "author", "source", "folder", "path", "hash"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "name": { "type": "string", "minLength": 1 },
          "author": { "type": "string", "minLength": 1 },
          "source": { "enum": ["included", "cream-of-the-crop", "projectm-classic", "milkdrop-original", "en-d"] },
          "folder": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "path": { "type": "string", "minLength": 3 },
          "hash": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
        }
      }
    }
  }
}
