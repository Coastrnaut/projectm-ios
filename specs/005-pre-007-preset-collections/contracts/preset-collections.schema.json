{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "projectM-iOS preset collections, schema version 1",
  "type": "object",
  "required": ["schemaVersion", "collections"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "collections": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["id", "name", "presets"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1, "maxLength": 60 },
          "presets": {
            "type": "array",
            "maxItems": 1000,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
