{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Coastrnaut/projectm-ios/docs/performance/thresholds.schema.json",
  "title": "projectM-iOS performance thresholds",
  "description": "QA-010: versioned performance budgets per device class (schema version 1). Read by scripts/check_performance_thresholds.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "thresholdsVersion",
    "updated",
    "metrics",
    "classes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "thresholdsVersion": {
      "type": "integer",
      "minimum": 1
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "description": {
      "type": "string"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fps1sP5",
        "frameIntervalP50Ms",
        "frameIntervalP95Ms",
        "droppedFramePercent",
        "peakMemoryMB",
        "audioAgeP95Ms",
        "coldLaunchMs"
      ],
      "properties": {
        "fps1sP5": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit",
            "direction",
            "description"
          ],
          "properties": {
            "unit": {
              "type": "string"
            },
            "direction": {
              "const": "min"
            },
            "description": {
              "type": "string"
            }
          }
        },
        "frameIntervalP50Ms": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit",
            "direction",
            "description"
          ],
          "properties": {
            "unit": {
              "type": "string"
            },
            "direction": {
              "const": "max"
            },
            "description": {
              "type": "string"
            }
          }
        },
        "frameIntervalP95Ms": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit",
            "direction",
            "description"
          ],
          "properties": {
            "unit": {
              "type": "string"
            },
            "direction": {
              "const": "max"
            },
            "description": {
              "type": "string"
            }
          }
        },
        "droppedFramePercent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit",
            "direction",
            "description"
          ],
          "properties": {
            "unit": {
              "type": "string"
            },
            "direction": {
              "const": "max"
            },
            "description": {
              "type": "string"
            }
          }
        },
        "peakMemoryMB": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit",
            "direction",
            "description"
          ],
          "properties": {
            "unit": {
              "type": "string"
            },
            "direction": {
              "const": "max"
            },
            "description": {
              "type": "string"
            }
          }
        },
        "audioAgeP95Ms": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit",
            "direction",
            "description"
          ],
          "properties": {
            "unit": {
              "type": "string"
            },
            "direction": {
              "const": "max"
            },
            "description": {
              "type": "string"
            }
          }
        },
        "coldLaunchMs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit",
            "direction",
            "description"
          ],
          "properties": {
            "unit": {
              "type": "string"
            },
            "direction": {
              "const": "max"
            },
            "description": {
              "type": "string"
            }
          }
        }
      }
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "models",
          "evidence",
          "targets"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,20}$"
          },
          "name": {
            "type": "string"
          },
          "models": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 40
            }
          },
          "evidence": {
            "type": "boolean"
          },
          "targets": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fps1sP5",
              "frameIntervalP50Ms",
              "frameIntervalP95Ms",
              "droppedFramePercent",
              "peakMemoryMB",
              "audioAgeP95Ms",
              "coldLaunchMs"
            ],
            "properties": {
              "fps1sP5": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "limit",
                  "basis"
                ],
                "properties": {
                  "limit": {
                    "type": "number",
                    "minimum": 0
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                }
              },
              "frameIntervalP50Ms": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "limit",
                  "basis"
                ],
                "properties": {
                  "limit": {
                    "type": "number",
                    "minimum": 0
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                }
              },
              "frameIntervalP95Ms": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "limit",
                  "basis"
                ],
                "properties": {
                  "limit": {
                    "type": "number",
                    "minimum": 0
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                }
              },
              "droppedFramePercent": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "limit",
                  "basis"
                ],
                "properties": {
                  "limit": {
                    "type": "number",
                    "minimum": 0
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                }
              },
              "peakMemoryMB": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "limit",
                  "basis"
                ],
                "properties": {
                  "limit": {
                    "type": "number",
                    "minimum": 0
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                }
              },
              "audioAgeP95Ms": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "limit",
                  "basis"
                ],
                "properties": {
                  "limit": {
                    "type": "number",
                    "minimum": 0
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                }
              },
              "coldLaunchMs": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "limit",
                  "basis"
                ],
                "properties": {
                  "limit": {
                    "type": "number",
                    "minimum": 0
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
